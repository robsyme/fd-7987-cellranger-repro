// Control: same task, but run in a scratch dir on the instance's local NVMe.
// With ~3 TB of input the intermediates may not fit next to Fusion's cache on
// 2.4 TB, so a "no space left on device" failure here is also a result.
process {
    withName: 'CELLRANGER_MULTI' {
        cpus    = 62
        memory  = '440 GB'
        time    = '10d'
        scratch = true
    }
}

// Workspace lineage store is in another AWS account; not needed here.
lineage.enabled = false
