// Repro: Cell Ranger's pipestance (and its shards) lives in the Fusion work dir.
// 62 CPUs / 440 GB leaves room for the Nextflow head job on the same r5ad.16xlarge.
process {
    withName: 'CELLRANGER_MULTI' {
        cpus   = 62
        memory = '440 GB'
        time   = '10d'
    }
}

// Workspace lineage store is in another AWS account; not needed here.
lineage.enabled = false
